---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import EditorialArticle from "../../components/EditorialArticle.astro";
import AcBtuCalculator from "../../components/AcBtuCalculator.astro";
import SmartAcDiagnosticTool from "../../components/SmartAcDiagnosticTool.astro";
import SectionContact from "../../components/SectionContact.astro";
import Footer from "../../components/Footer.astro";
import BookingModal from "../../components/BookingModal.astro";
import { guidesData } from "../../data/guides-data";
import { siteSeoConfig } from "../../data/seo-keywords";
import type { EditorialSection } from "../../data/seo-silos/types";

export function getStaticPaths() {
  return guidesData.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const otherGuides = guidesData.filter((g) => g.slug !== guide.slug).slice(0, 6);

const mappedSections: EditorialSection[] = guide.sections.map((sec, idx) => ({
  id: `guide-sec-${idx + 1}`,
  h2: sec.heading,
  paragraphs: sec.paragraphs,
  h3Blocks: sec.subheadings,
  bullets: sec.bullets,
  callout: sec.callout
    ? { type: "tip", title: sec.callout.title, text: sec.callout.text }
    : undefined,
  table: sec.table
    ? { caption: sec.heading, headers: sec.table.headers, rows: sec.table.rows }
    : undefined,
}));

const breadcrumbs = [
  { name: "الرئيسية", url: "/" },
  { name: "الأدلة الهندسية والأسعار", url: "/guides" },
  { name: guide.category, url: `/guides/${guide.slug}` },
];
const pageTitle = `${guide.title} | ${siteSeoConfig.brandFullName}`;
---

<BaseLayout
  title={pageTitle}
  description={guide.description}
  extraKeywords={guide.keywords}
  canonicalPath={`/guides/${guide.slug}`}
  breadcrumbs={breadcrumbs}
  pageFaqs={guide.faqs}
  article={{
    headline: guide.title,
    dateModified: guide.updatedAt,
    section: guide.category,
  }}
>
  <Navbar activePath="/guides" breadcrumbs={breadcrumbs} />

  <main>
    <section class="section section--bayou">
      <div class="container detail-hero">
        <div class="meta-pills">
          <span class="section-eyebrow">{guide.category}</span>
          <span class="time-pill">
            آخر تحديث: {guide.updatedAt} • {guide.readTime}
          </span>
        </div>
        <h1 class="heading-1 detail-hero__title">{guide.title}</h1>
        <p class="text-lead detail-hero__desc">{guide.description}</p>

        <div class="geo-quick-answer">
          <strong class="geo-quick-answer__label">
            الخلاصة المباشرة من مهندسي أركان:
          </strong>
          <p>{guide.quickAnswer}</p>
        </div>
      </div>
    </section>

    {guide.slug === "ac-horsepower-room-calculator" && <AcBtuCalculator />}
    {["ac-error-codes-egypt", "ac-maintenance-prices-egypt"].includes(
      guide.slug,
    ) && <SmartAcDiagnosticTool />}

    <!-- Full Encyclopedia Guide + Sticky TOC -->
    <EditorialArticle
      tocTitle="فهرس محتويات الدليل"
      readTime={guide.readTime}
      primaryKeyword={guide.keywords[0]}
      sections={mappedSections}
    />

    <section class="section section--pearl20">
      <div class="container">
        {guide.faqs.length > 0 && (
          <div style="margin-bottom: 56px;">
            <div class="section-header">
              <span class="section-eyebrow">أسئلة القراء</span>
              <h2 class="heading-2">أسئلة شائعة حول {guide.category}</h2>
            </div>
            <div class="faq-list">
              {guide.faqs.map((f, idx) => (
                <details class="faq-item" open={idx === 0}>
                  <summary>{f.question}</summary>
                  <p>{f.answer}</p>
                </details>
              ))}
            </div>
          </div>
        )}

        <div class="other-guides">
          <h3 class="heading-3">أدلة مرجعية أخرى من مكتبة أركان</h3>
          <div class="other-guides__grid">
            {otherGuides.map((og) => (
              <a href={`/guides/${og.slug}`} class="other-guide-card">
                <span class="og-cat">{og.category}</span>
                <strong>{og.title}</strong>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <SectionContact />
  </main>

  <Footer />
  <BookingModal />
</BaseLayout>

<style>
  .detail-hero {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .meta-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .time-pill {
    background-color: rgba(250, 250, 249, 0.14);
    color: var(--pearl-10);
    font-family: var(--font-heading);
    font-size: 13px;
    padding: 6px 16px;
    border-radius: 9999px;
  }
  .detail-hero__title {
    max-width: 900px;
    font-size: clamp(28px, 3.4vw, 42px);
  }
  .detail-hero__desc {
    max-width: 780px;
  }

  .other-guides {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .other-guides__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .other-guide-card {
    background-color: var(--pearl-10);
    border-radius: 20px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--font-heading);
    color: var(--bayou-110);
    box-shadow: var(--card-shadow);
    transition: background-color 0.2s ease;
  }
  .other-guide-card:hover {
    background-color: var(--sun-60);
    color: var(--ebony-130);
  }
  .og-cat {
    font-size: 12px;
    color: var(--ebony-100);
  }

  @media (max-width: 860px) {
    .other-guides__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
