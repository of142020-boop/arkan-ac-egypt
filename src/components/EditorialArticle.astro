---
import type { EditorialSection } from '../data/seo-silos/types';

interface Props {
  tocTitle?: string;
  readTime?: string;
  primaryKeyword?: string;
  sections: EditorialSection[];
}

const {
  tocTitle = 'فهرس المحتويات التفصيلي',
  readTime = '6 دقائق قراءة',
  primaryKeyword,
  sections = [],
} = Astro.props;
---

{
  sections.length > 0 && (
    <section class="section section--pearl10 editorial-shell">
      <div class="container editorial-layout">
        <!-- Sticky Table of Contents Sidebar (Creates Google Jump-To Sitelinks!) -->
        <aside class="editorial-toc" aria-label={tocTitle}>
          <div class="editorial-toc__card">
            <div class="editorial-toc__meta">
              <span class="toc-badge">محتوى هندسي مراجع</span>
              <span class="toc-time">⏱ {readTime}</span>
            </div>
            <h2 class="editorial-toc__title">{tocTitle}</h2>
            <ol class="editorial-toc__list">
              {sections.map((sec, idx) => (
                <li>
                  <a href={`#${sec.id}`}>
                    <span class="toc-num" dir="ltr">0{idx + 1}</span>
                    <span>{sec.h2}</span>
                  </a>
                </li>
              ))}
            </ol>
            {primaryKeyword && (
              <div class="editorial-toc__topic">
                <span>التخصص المحوري:</span>
                <strong>{primaryKeyword}</strong>
              </div>
            )}
            <button type="button" class="btn-gold btn-gold--sm" data-open-booking style="width: 100%; margin-top: 8px;">
              استشارة أو حجز فني الآن
            </button>
          </div>
        </aside>

        <!-- Main Long-Form Editorial Content -->
        <div class="editorial-main">
          {sections.map((sec) => (
            <article id={sec.id} class="editorial-section">
              <h2 class="heading-2 editorial-h2">{sec.h2}</h2>

              {sec.paragraphs.map((p) => (
                <p class="editorial-p" set:html={p} />
              ))}

              {sec.h3Blocks &&
                sec.h3Blocks.map((sub) => (
                  <div class="editorial-h3-block">
                    <h3 class="heading-3 editorial-h3">{sub.h3}</h3>
                    {sub.paragraphs.map((sp) => (
                      <p class="editorial-p" set:html={sp} />
                    ))}
                    {sub.bullets && (
                      <ul class="editorial-bullets">
                        {sub.bullets.map((b) => (
                          <li set:html={b} />
                        ))}
                      </ul>
                    )}
                  </div>
                ))}

              {sec.bullets && (
                <ul class="editorial-bullets">
                  {sec.bullets.map((b) => (
                    <li set:html={b} />
                  ))}
                </ul>
              )}

              {sec.table && (
                <div class="table-wrap editorial-table-wrap">
                  <table class="data-table">
                    {sec.table.caption && <caption class="table-caption">{sec.table.caption}</caption>}
                    <thead>
                      <tr>
                        {sec.table.headers.map((h) => (
                          <th scope="col">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {sec.table.rows.map((row) => (
                        <tr>
                          {row.map((cell, cIdx) => (
                            <td>{cIdx === 0 ? <strong>{cell}</strong> : <span set:html={cell} />}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {sec.callout && (
                <div class={`editorial-callout editorial-callout--${sec.callout.type}`}>
                  <strong class="editorial-callout__title">
                    {sec.callout.type === 'warning' ? '⚠️ ' : sec.callout.type === 'fact' ? '📊 ' : '💡 '}
                    {sec.callout.title}
                  </strong>
                  <p set:html={sec.callout.text} />
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .editorial-layout {
    display: grid;
    grid-template-columns: 310px 1fr;
    gap: 44px;
    align-items: start;
  }

  .editorial-toc {
    position: sticky;
    top: 96px;
  }

  .editorial-toc__card {
    background-color: var(--pearl-20);
    border-radius: 24px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border: 1px solid rgba(55, 93, 108, 0.1);
  }

  .editorial-toc__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 12px;
  }

  .toc-badge {
    background-color: var(--mint-tag);
    color: var(--bayou-120);
    font-family: var(--font-heading);
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 9999px;
  }

  .toc-time {
    color: var(--ebony-100);
    font-weight: 600;
  }

  .editorial-toc__title {
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 800;
    color: var(--bayou-110);
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(55, 93, 108, 0.12);
  }

  .editorial-toc__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .editorial-toc__list a {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 12px;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--ebony-130);
    line-height: 1.45;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .editorial-toc__list a:hover {
    background-color: var(--pearl-10);
    color: var(--bayou-110);
  }

  .toc-num {
    font-family: var(--font-num);
    font-weight: 700;
    color: var(--sun-80);
    flex-shrink: 0;
  }

  .editorial-toc__topic {
    background-color: var(--pearl-10);
    padding: 10px 14px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 12px;
    color: var(--ebony-100);
  }

  .editorial-toc__topic strong {
    color: var(--bayou-110);
    font-family: var(--font-heading);
    font-size: 13px;
  }

  .editorial-main {
    display: flex;
    flex-direction: column;
    gap: 48px;
    min-width: 0;
  }

  .editorial-section {
    scroll-margin-top: 104px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--pearl-20);
  }

  .editorial-section:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .editorial-h2 {
    font-size: clamp(23px, 2.5vw, 30px);
    position: relative;
    padding-right: 16px;
  }

  .editorial-h2::before {
    content: '';
    position: absolute;
    right: 0;
    top: 6px;
    bottom: 6px;
    width: 5px;
    border-radius: 4px;
    background-color: var(--sun-80);
  }

  .editorial-p {
    font-size: 17px;
    line-height: 1.95;
    color: var(--ebony-130);
  }

  .editorial-p :global(a),
  .editorial-bullets :global(a),
  .editorial-callout :global(a) {
    color: var(--bayou-110);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: rgba(233, 172, 53, 0.7);
    text-underline-offset: 4px;
  }

  .editorial-p :global(a:hover),
  .editorial-bullets :global(a:hover) {
    color: var(--bayou-120);
    background-color: rgba(241, 202, 126, 0.25);
  }

  .editorial-h3-block {
    background-color: var(--pearl-20);
    border-radius: 22px;
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .editorial-h3 {
    font-size: 20px;
  }

  .editorial-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background-color: var(--pearl-20);
    padding: 22px 26px;
    border-radius: 20px;
  }

  .editorial-h3-block .editorial-bullets {
    background-color: var(--pearl-10);
    padding: 18px 22px;
  }

  .editorial-bullets li {
    position: relative;
    padding-right: 22px;
    font-size: 16px;
    line-height: 1.8;
    color: var(--ebony-130);
  }

  .editorial-bullets li::before {
    content: '✓';
    position: absolute;
    right: 0;
    top: 0;
    color: var(--bayou-110);
    font-weight: 800;
  }

  .editorial-table-wrap {
    margin-top: 6px;
  }

  .table-caption {
    text-align: right;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    color: var(--ebony-100);
    padding: 12px 16px;
    background-color: var(--pearl-20);
  }

  .editorial-callout {
    border-radius: 20px;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15.5px;
    line-height: 1.85;
  }

  .editorial-callout--tip {
    background-color: rgba(205, 229, 221, 0.45);
    border-right: 4px solid var(--bayou-110);
  }

  .editorial-callout--warning {
    background-color: rgba(241, 202, 126, 0.25);
    border-right: 4px solid var(--sun-80);
  }

  .editorial-callout--fact {
    background-color: var(--bayou-20);
    border-right: 4px solid var(--bayou-120);
  }

  .editorial-callout__title {
    font-family: var(--font-heading);
    font-size: 16px;
    color: var(--bayou-120);
  }

  @media (max-width: 1024px) {
    .editorial-layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .editorial-toc {
      position: static;
    }
  }
</style>
