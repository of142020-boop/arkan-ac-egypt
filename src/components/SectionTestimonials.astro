---
import { testimonialsContent } from '../data/site-content';
---

<section id="testimonials" class="section section--pearl10">
  <div class="container">
    <div class="section-header">
      <span class="section-eyebrow">تقييمات حقيقية من عملائنا</span>
      <h2 class="heading-2">{testimonialsContent.title}</h2>
      <p class="text-body">{testimonialsContent.subtitle}</p>
    </div>

    <div class="testimonials-grid">
      {
        testimonialsContent.items.map((item) => (
          <article class="testimonial-card">
            <div class="testimonial-card__head">
              <h3 class="heading-3">{item.name}</h3>
              <span class="testimonial-card__role">{item.role}</span>
            </div>
            <div class="testimonial-card__stars" aria-label="تقييم 5 نجوم">★★★★★</div>
            <p class="text-body testimonial-card__quote">{item.quote}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .testimonial-card {
    background-color: var(--pearl-20);
    border-radius: var(--radius-card);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .testimonial-card__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .testimonial-card__role {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    color: var(--ebony-100);
  }

  .testimonial-card__stars {
    color: var(--sun-80);
    font-size: 18px;
    letter-spacing: 2px;
    line-height: 1;
  }

  .testimonial-card__quote {
    color: var(--ebony-130);
    font-size: 15px;
  }

  @media (max-width: 1080px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
