---
import ArkanLogo from './ArkanLogo.astro';
import { siteSeoConfig } from '../data/seo-keywords';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  activePath?: string;
  breadcrumbs?: BreadcrumbItem[];
  transparent?: boolean;
}

const { activePath = '/', breadcrumbs = [], transparent = false } = Astro.props;

const navLinks = [
  { label: 'الرئيسية', href: '/' },
  { label: 'الخدمات', href: '/services' },
  { label: 'الماركات', href: '/brands' },
  { label: 'المناطق', href: '/areas' },
  { label: 'عقود الشركات', href: '/corporate-contracts' },
  { label: 'الحاسبات والتشخيص', href: '/tools' },
  { label: 'الأدلة', href: '/guides' },
];
---

<header class={`site-nav ${transparent ? 'site-nav--hero' : ''}`}>
  <div class="site-nav__inner">
    <a href="/" aria-label={siteSeoConfig.brandFullName}>
      <ArkanLogo variant="dark" />
    </a>

    <nav class="site-nav__links" aria-label="القائمة الرئيسية">
      {
        navLinks.map((link) => {
          const isActive =
            link.href === '/'
              ? activePath === '/'
              : activePath.startsWith(link.href);
          return (
            <a
              href={link.href}
              class={`site-nav__link ${isActive ? 'is-active' : ''}`}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="site-nav__actions">
      <a href={`tel:${siteSeoConfig.phone}`} class="site-nav__hotline" aria-label="الخط الساخن">
        <span class="site-nav__hotline-dot"></span>
        <span>الخط الساخن: {siteSeoConfig.hotline}</span>
      </a>
      <button type="button" class="btn-gold btn-gold--sm" data-open-booking>
        احجز صيانة
      </button>
    </div>

    <button
      type="button"
      class="site-nav__burger"
      id="site-menu-toggle"
      aria-label="فتح القائمة"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div class="site-drawer" id="site-drawer" hidden>
    <div class="site-drawer__inner">
      {
        navLinks.map((link) => (
          <a href={link.href} class="site-drawer__link">
            {link.label}
          </a>
        ))
      }
      <div class="site-drawer__actions">
        <button type="button" class="btn-gold btn-gold--md" data-open-booking style="width: 100%;">
          احجز موعد صيانة أو معاينة
        </button>
        <a href={`tel:${siteSeoConfig.phone}`} class="btn-outline" style="width: 100%; padding: 12px;">
          اتصال فوري: {siteSeoConfig.hotline}
        </a>
      </div>
    </div>
  </div>

  {
    breadcrumbs.length > 0 && (
      <nav class="site-breadcrumb" aria-label="مسار الصفحة">
        <div class="site-breadcrumb__inner">
          {breadcrumbs.map((crumb, idx) => (
            <>
              {idx > 0 && <span class="site-breadcrumb__sep">/</span>}
              {idx === breadcrumbs.length - 1 ? (
                <span class="site-breadcrumb__current">{crumb.name}</span>
              ) : (
                <a href={crumb.url} class="site-breadcrumb__link">
                  {crumb.name}
                </a>
              )}
            </>
          ))}
        </div>
      </nav>
    )
  }
</header>

<style>
  .site-nav {
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(250, 250, 249, 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(55, 93, 108, 0.1);
  }

  .site-nav__inner {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 16px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .site-nav__link {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
    color: var(--bayou-110);
    padding: 6px 2px;
    position: relative;
    transition: color 0.2s ease;
  }

  .site-nav__link:hover,
  .site-nav__link.is-active {
    color: var(--bayou-120);
  }

  .site-nav__link.is-active::after {
    content: '';
    position: absolute;
    right: 0;
    left: 0;
    bottom: 0;
    height: 2.5px;
    border-radius: 2px;
    background-color: var(--sun-80);
  }

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .site-nav__hotline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    color: var(--bayou-110);
    background-color: var(--pearl-20);
    padding: 9px 14px;
    border-radius: 9999px;
  }

  .site-nav__hotline-dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background-color: #2ea44f;
  }

  .site-nav__burger {
    display: none;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background-color: var(--pearl-20);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .site-nav__burger span {
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background-color: var(--bayou-110);
    display: block;
  }

  .site-drawer {
    background-color: var(--pearl-10);
    border-bottom: 2px solid var(--pearl-20);
    padding: 16px 20px 24px;
    box-shadow: 0 16px 32px rgba(45, 54, 57, 0.1);
  }

  .site-drawer__inner {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .site-drawer__link {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    color: var(--bayou-110);
    padding: 10px 8px;
    border-bottom: 1px solid var(--pearl-20);
  }

  .site-drawer__actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 12px;
  }

  .site-breadcrumb {
    background-color: var(--pearl-20);
    border-top: 1px solid rgba(55, 93, 108, 0.08);
  }

  .site-breadcrumb__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 10px 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-size: 13px;
    color: var(--ebony-100);
  }

  .site-breadcrumb__link:hover {
    color: var(--bayou-110);
    text-decoration: underline;
  }

  .site-breadcrumb__current {
    color: var(--bayou-110);
    font-weight: 700;
  }

  @media (max-width: 1040px) {
    .site-nav__links,
    .site-nav__actions {
      display: none;
    }

    .site-nav__burger {
      display: flex;
    }

    .site-nav__inner,
    .site-breadcrumb__inner {
      padding-inline: 20px;
    }
  }
</style>

<script>
  const btn = document.getElementById('site-menu-toggle');
  const drawer = document.getElementById('site-drawer');
  if (btn && drawer) {
    btn.addEventListener('click', () => {
      const hidden = drawer.hasAttribute('hidden');
      if (hidden) {
        drawer.removeAttribute('hidden');
        btn.setAttribute('aria-expanded', 'true');
      } else {
        drawer.setAttribute('hidden', '');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
