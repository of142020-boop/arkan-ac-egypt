---
import { siteSeoConfig } from '../data/seo-keywords';
---

<div class="floating-bar" aria-label="تواصل سريع مع أركان">
  <a
    href={`https://wa.me/${siteSeoConfig.whatsapp}?text=${encodeURIComponent('مرحباً شركة أركان، أحتاج استشارة أو حجز فني تكييف')}`}
    target="_blank"
    rel="noopener noreferrer"
    class="floating-bar__btn floating-bar__btn--wa"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.03 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.49 1.34 5.01L2 22l5.13-1.34A9.96 9.96 0 0 0 12.03 22c5.52 0 10-4.48 10-10s-4.48-10-10-10zm5.82 14.12c-.24.68-1.41 1.3-1.95 1.38-.5.08-1.13.11-1.83-.11-.42-.13-.96-.31-1.66-.61-2.92-1.26-4.82-4.21-4.97-4.41-.14-.19-1.19-1.58-1.19-3.02 0-1.44.75-2.15 1.02-2.44.27-.29.59-.36.79-.36.2 0 .4 0 .57.01.18.01.43-.07.67.51.25.6.85 2.07.92 2.22.07.15.12.32.02.52-.1.2-.15.32-.29.49-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.03 1.12 1 2.06 1.31 2.35 1.46.29.15.46.12.63-.07.17-.2.73-.85.92-1.14.2-.29.39-.24.66-.15.27.1 1.71.81 2 .95.29.15.49.22.56.34.07.12.07.7-.17 1.38z" />
    </svg>
    <span>واتساب فوري</span>
  </a>

  <a href={`tel:${siteSeoConfig.phone}`} class="floating-bar__btn floating-bar__btn--call">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.58 2.81.7A2 2 0 0 1 22 16.92z" />
    </svg>
    <span>اتصال {siteSeoConfig.hotline}</span>
  </a>
</div>

<style>
  .floating-bar {
    position: fixed;
    left: 20px;
    bottom: 20px;
    z-index: 60;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .floating-bar__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 18px;
    border-radius: 9999px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    transition: transform 0.2s ease;
  }

  .floating-bar__btn:hover {
    transform: translateY(-2px);
  }

  .floating-bar__btn--wa {
    background-color: #1fa855;
    color: #ffffff;
  }

  .floating-bar__btn--call {
    background-image: var(--gold-gradient);
    color: var(--ebony-130);
  }

  @media (max-width: 640px) {
    .floating-bar {
      left: 12px;
      right: 12px;
      bottom: 12px;
      flex-direction: row;
    }

    .floating-bar__btn {
      flex: 1;
      padding: 13px 12px;
      font-size: 13.5px;
    }
  }
</style>
