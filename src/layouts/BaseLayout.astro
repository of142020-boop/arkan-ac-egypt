---
import '../styles/global.css';
import FloatingContactBar from '../components/FloatingContactBar.astro';
import { siteSeoConfig, keywordClusters, topEgyptServiceKeywords } from '../data/seo-keywords';
import { faqItems } from '../data/site-content';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface HowToStep {
  name: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  extraKeywords?: string[];
  canonicalPath?: string;
  breadcrumbs?: BreadcrumbItem[];
  pageFaqs?: FaqItem[];
  howTo?: { name: string; steps: HowToStep[] };
  article?: { headline: string; dateModified: string; section: string };
  geo?: { placename: string; lat: number; lng: number };
}

const {
  title = siteSeoConfig.defaultTitle,
  description = siteSeoConfig.defaultDescription,
  extraKeywords = [],
  canonicalPath = '',
  breadcrumbs = [],
  pageFaqs = faqItems,
  howTo,
  article,
  geo = { placename: 'Cairo, Egypt', lat: 30.0074, lng: 31.4913 },
} = Astro.props;

const baseUrl = siteSeoConfig.domain.replace(/\/$/, '');
const canonicalUrl = canonicalPath ? `${baseUrl}${canonicalPath}` : `${baseUrl}/`;

const allKeywords = [
  ...new Set([
    ...extraKeywords,
    ...siteSeoConfig.primaryKeywords,
    ...topEgyptServiceKeywords.slice(0, 50).map((k) => k.keyword),
  ]),
].join(', ');

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${baseUrl}/#website`,
    url: `${baseUrl}/`,
    name: siteSeoConfig.brandFullName,
    inLanguage: 'ar-EG',
    publisher: { '@id': `${baseUrl}/#organization` },
  },
  {
    '@type': 'HVACBusiness',
    '@id': `${baseUrl}/#organization`,
    name: siteSeoConfig.brandFullName,
    alternateName: ['أركان للتكييف', 'Arkan HVAC Egypt', 'شركة أركان لصيانة وتركيب التكييف في مصر'],
    url: `${baseUrl}/`,
    telephone: `+20-${siteSeoConfig.phone.replace(/^0/, '')}`,
    email: siteSeoConfig.email,
    priceRange: 'EGP 250 - EGP 25000',
    currenciesAccepted: 'EGP',
    paymentAccepted: 'Cash, Bank Transfer, InstaPay, Credit Card',
    image: `${baseUrl}/assets/figma/65bf5.png`,
    logo: `${baseUrl}/assets/figma/f3f01.svg`,
    address: {
      '@type': 'PostalAddress',
      streetAddress: siteSeoConfig.address,
      addressLocality: 'القاهرة الجديدة',
      addressRegion: 'القاهرة',
      addressCountry: 'EG',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: geo.lat,
      longitude: geo.lng,
    },
    knowsAbout: [
      'صيانة التكييفات في مصر',
      'تركيب وتأسيس مواسير التكييف',
      'التكييف الكونسيلد والمركزي VRF',
      'شحن فريون R410a و R22 الأصلي',
      'غسيل وتنظيف التكييف بالكيس بدون فك',
      'تشخيص أكواد أعطال شارب وكاريير وإل جي وميديا ويونيون إير وجري',
    ],
    areaServed: [
      { '@type': 'Country', name: 'Egypt' },
      ...siteSeoConfig.serviceAreas.map((area) => ({ '@type': 'City', name: area })),
    ],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'خدمات أركان لصيانة وتركيب التكييف في مصر',
      itemListElement: keywordClusters.map((cluster) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: cluster.category,
          description: cluster.description,
          url: `${baseUrl}/services/${cluster.slug}`,
          areaServed: 'EG',
        },
      })),
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '4.9',
      reviewCount: '1358',
      bestRating: '5',
      worstRating: '1',
    },
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
        opens: '00:00',
        closes: '23:59',
      },
    ],
  },
  {
    '@type': 'WebPage',
    '@id': `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: title,
    description,
    inLanguage: 'ar-EG',
    isPartOf: { '@id': `${baseUrl}/#website` },
    about: { '@id': `${baseUrl}/#organization` },
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['h1', '.geo-quick-answer', '.hero-description'],
    },
  },
];

if (breadcrumbs.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: breadcrumbs.map((b, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: b.name,
      item: b.url.startsWith('http') ? b.url : `${baseUrl}${b.url}`,
    })),
  });
}

if (pageFaqs.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: pageFaqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  });
}

if (howTo && howTo.steps.length > 0) {
  graph.push({
    '@type': 'HowTo',
    '@id': `${canonicalUrl}#howto`,
    name: howTo.name,
    inLanguage: 'ar-EG',
    step: howTo.steps.map((s, idx) => ({
      '@type': 'HowToStep',
      position: idx + 1,
      name: s.name,
      text: s.text,
    })),
  });
}

if (article) {
  graph.push({
    '@type': 'TechArticle',
    '@id': `${canonicalUrl}#article`,
    headline: article.headline,
    description,
    articleSection: article.section,
    inLanguage: 'ar-EG',
    datePublished: article.dateModified,
    dateModified: article.dateModified,
    author: { '@id': `${baseUrl}/#organization` },
    publisher: { '@id': `${baseUrl}/#organization` },
    mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` },
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={allKeywords} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={siteSeoConfig.brandFullName} />
    <meta name="geo.region" content="EG" />
    <meta name="geo.placename" content={geo.placename} />
    <meta name="geo.position" content={`${geo.lat};${geo.lng}`} />
    <meta name="ICBM" content={`${geo.lat}, ${geo.lng}`} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ar-EG" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" title="LLMs Context" href="/llms.txt" />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="ar_EG" />
    <meta property="og:site_name" content={siteSeoConfig.brandFullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${baseUrl}/assets/figma/65bf5.png`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${baseUrl}/assets/figma/65bf5.png`} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@400;500;600;700&family=Barlow:wght@400;500;600&family=Cairo:wght@400;600;700;800&family=Fira+Sans+Extra+Condensed:wght@600&family=Tajawal:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/assets/figma/f3f01.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    <FloatingContactBar />
  </body>
</html>
